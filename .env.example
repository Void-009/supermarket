APP_NAME="M-DELIGHT SINGER STORES"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=online_supermarket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# Production: use a real mail transport (smtp, ses, postmark, etc.)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@mdelight.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverb WebSocket server
REVERB_APP_ID=802650
REVERB_APP_KEY=v1gipfshgd9p62i4fu0j
REVERB_APP_SECRET=fnh8xduuoe2lfw9ek6vi
# Public address browsers connect to (through the HTTPS reverse proxy on 443)
REVERB_HOST="mdelightsingerstores.com"
REVERB_PORT=443
REVERB_SCHEME=https
# Comma-separated list of allowed browser origins (must match APP_URL)
REVERB_ALLOWED_ORIGINS="https://mdelightsingerstores.com,https://www.mdelightsingerstores.com"
# Where Reverb actually binds (private port; nginx forwards /app/ -> this)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8130

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_WSS_PORT=443
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# POS Export File Path (use forward slashes for cross-platform compatibility)
# Windows example: C:/Users/Smk/Desktop/MDELIGHT SINGER STORES/EXCEL AUTOMATION/items_export.xlsx
# Linux example:   /var/www/supermarket/storage/app/pos/items_export.xlsx
POS_EXPORT_PATH="items_export.xlsx"

VITE_APP_NAME="${APP_NAME}"

# Web Push (VAPID) - generate with: php artisan vendor:publish --tag=vapor-... or online VAPID generator
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:mdelightsingerstores@gmail.com
